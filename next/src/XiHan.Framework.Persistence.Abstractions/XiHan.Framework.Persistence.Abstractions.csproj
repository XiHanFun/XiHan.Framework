<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>XiHan.Framework.Persistence.Abstractions</PackageId>
    <RootNamespace>XiHan.Framework.Persistence.Abstractions</RootNamespace>
    <Description>XiHan Framework 持久化契约（Ring 2）：仓储、工作单元、查询、标识生成、Transaction 阶段中间件与实体协议约定。</Description>
    <PackageTags>xihan;framework;persistence;repository;unit-of-work</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XiHan.Framework.Kernel/XiHan.Framework.Kernel.csproj" />
    <ProjectReference Include="../XiHan.Framework.Localization.Abstractions/XiHan.Framework.Localization.Abstractions.csproj" />
    <ProjectReference Include="../XiHan.Framework.Domain/XiHan.Framework.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 消息模板的译文：一种语言一个文件（RFC-0010），由本地化目录按 Localization/<区域>.json 读取 -->
    <EmbeddedResource Include="Localization/*.json" LogicalName="Localization/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
