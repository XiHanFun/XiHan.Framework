<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>XiHan.Framework.Primitives</PackageId>
    <RootNamespace>XiHan.Framework.Primitives</RootNamespace>
    <Description>XiHan Framework 原语层（Ring 0）：Result、Error、Maybe、TypedId、调用上下文契约、清单模型与稳定性标记。只增不改。</Description>
    <PackageTags>xihan;framework;primitives</PackageTags>
  </PropertyGroup>

  <!-- 版本常量由构建期生成，FrameworkInfo.Version 不经反射读取程序集特性 -->
  <Target Name="GenerateFrameworkVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_FrameworkVersionFile>$(IntermediateOutputPath)FrameworkVersion.g.cs</_FrameworkVersionFile>
    </PropertyGroup>
    <ItemGroup>
      <_FrameworkVersionLine Include="// &lt;auto-generated/&gt;" />
      <_FrameworkVersionLine Include="namespace XiHan.Framework.Primitives%3B" />
      <_FrameworkVersionLine Include="internal static class GeneratedVersion" />
      <_FrameworkVersionLine Include="{" />
      <_FrameworkVersionLine Include="    public const string Value = &quot;$(Version)&quot;%3B" />
      <_FrameworkVersionLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_FrameworkVersionFile)" Lines="@(_FrameworkVersionLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_FrameworkVersionFile)" />
      <FileWrites Include="$(_FrameworkVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
