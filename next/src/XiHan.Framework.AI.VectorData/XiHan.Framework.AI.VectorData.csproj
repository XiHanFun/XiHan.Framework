<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>XiHan.Framework.AI.VectorData</PackageId>
    <RootNamespace>XiHan.Framework.AI.VectorData</RootNamespace>
    <Description>XiHan Framework AI 的知识库 Provider：把 IKnowledgeStore 映射到应用注册的 Microsoft.Extensions.VectorData 向量存储（任意连接器）。</Description>
    <PackageTags>xihan;framework;ai;knowledge;rag;vectordata</PackageTags>
    <!-- VectorData 的记录映射基于反射与表达式；Native AOT 场景另行验证 -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XiHan.Framework.AI.Abstractions/XiHan.Framework.AI.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
  </ItemGroup>
</Project>
