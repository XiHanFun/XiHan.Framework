<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>XiHan.Framework.Caching.Hybrid</PackageId>
    <RootNamespace>XiHan.Framework.Caching.Hybrid</RootNamespace>
