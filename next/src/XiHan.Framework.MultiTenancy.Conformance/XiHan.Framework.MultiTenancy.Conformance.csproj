<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>XiHan.Framework.MultiTenancy.Conformance</PackageId>
    <RootNamespace>XiHan.Framework.MultiTenancy.Conformance</RootNamespace>
    <Description>XiHan Framework 多租户一致性套件：任何 ITenantStore 实现都必须通过的 xUnit 抽象测试类。</Description>
    <PackageTags>xihan;framework;multitenancy;conformance;xunit</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- CA1707：用例名沿用测试项目的下划线分段约定 -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XiHan.Framework.MultiTenancy.Abstractions/XiHan.Framework.MultiTenancy.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>
</Project>
