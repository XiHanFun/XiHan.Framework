<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>XiHan.Framework.Workflow.Conformance</PackageId>
    <RootNamespace>XiHan.Framework.Workflow.Conformance</RootNamespace>
    <Description>XiHan Framework 工作流一致性套件：任何工作流存储、实例锁与引擎装配都必须通过的 xUnit 抽象测试类。</Description>
    <PackageTags>xihan;framework;workflow;conformance;xunit</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- CA1707：用例名沿用测试项目的下划线分段约定 -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XiHan.Framework.Workflow.Abstractions/XiHan.Framework.Workflow.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>
</Project>
