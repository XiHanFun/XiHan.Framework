{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.xihanfun.com/manifest/v1.json",
  "title": "XiHan manifest",
  "description": "xihan.manifest.json：能力包、Provider、插件、宿主与协议适配器的自描述清单。",
  "type": "object",
  "required": ["id", "version", "primitives", "stability", "kind"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^xihan\\.[a-z][a-z0-9]*\\.[a-z][a-z0-9-]*$",
      "description": "清单 ID：xihan.<领域>.<名称>"
    },
    "package": { "type": "string", "description": "所属包 ID（.NET 为 NuGet 包 ID）" },
    "version": { "$ref": "#/$defs/semver" },
    "primitives": { "type": "string", "pattern": "^[1-9][0-9]*$", "description": "所依赖的原语层大版本" },
    "stability": { "enum": ["stable", "preview", "experimental", "internal", "deprecated"] },
    "kind": { "enum": ["capability", "provider", "plugin", "host", "protocol"] },
    "role": { "enum": ["provider", "default"], "default": "provider", "description": "default：没有显式 Provider 时被选中的实现" },
    "isolation": { "enum": ["in-process", "wasm", "out-of-process"], "description": "仅 kind=plugin" },
    "provides": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true },
    "requires": { "type": "array", "items": { "$ref": "#/$defs/requirement" }, "uniqueItems": true },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "contributes": { "$ref": "#/$defs/contributions" },
    "activation": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(onStartup|onOperation:[a-z0-9.*-]+|onEvent:[a-z0-9.*-]+)$" },
      "default": ["onStartup"]
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(net\\.outbound|fs\\.read|fs\\.write|capability):.+$" },
      "description": "插件所需权限，宿主配置授予"
    },
    "entry": { "type": "string", "description": "入口类型的完全限定名（.NET）或等价标识" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "capabilityId": { "type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z][a-z0-9-]*$" },
    "capability": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/capabilityId" },
        "version": { "type": "string", "pattern": "^(\\^)?[1-9][0-9]*$" },
        "optional": { "type": "boolean", "default": false }
      }
    },
    "binding": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "type": { "type": "string", "pattern": "^[a-z]+(:[a-z]+)?$", "description": "connection:relational、cache:distributed、queue、blob" },
        "required": { "type": "boolean", "default": true }
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pipeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["middleware", "stage"],
            "additionalProperties": false,
            "properties": {
              "middleware": { "type": "string" },
              "stage": { "enum": ["ingress", "observe", "resilience", "authenticate", "tenant", "authorize", "validate", "idempotency", "transaction", "handle", "egress"] },
              "before": { "type": "array", "items": { "type": "string" } },
              "after": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "operations": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" } },
        "config": {
          "type": "object",
          "required": ["section"],
          "additionalProperties": false,
          "properties": {
            "section": { "type": "string", "pattern": "^XiHan:[A-Z][A-Za-z0-9]*$" },
            "schema": { "type": "string" }
          }
        },
        "permissions": { "type": "array", "items": { "type": "string" }, "description": "此包定义的权限码" },
        "health": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" } }
      }
    }
  }
}
