{
  "$comment": "Wasm 插件 ABI v1 的导出与导入表；签名用 Wasm 值类型；见 spec/plugin/wasm.md",
  "abiVersion": 1,
  "exports": {
    "required": [
      { "name": "memory", "kind": "memory" },
      { "name": "xihan_abi_version", "params": [], "results": ["i32"] },
      { "name": "xihan_alloc", "params": ["i32"], "results": ["i32"] },
      { "name": "xihan_free", "params": ["i32", "i32"], "results": [] },
      { "name": "xihan_handshake", "params": ["i32", "i32"], "results": ["i64"] },
      { "name": "xihan_configure", "params": ["i32", "i32"], "results": ["i64"] },
      { "name": "xihan_start", "params": ["i32", "i32"], "results": ["i64"] },
      { "name": "xihan_stop", "params": ["i32", "i32"], "results": ["i64"] },
      { "name": "xihan_health", "params": ["i32", "i32"], "results": ["i64"] },
      { "name": "xihan_invoke", "params": ["i32", "i32"], "results": ["i64"] }
    ],
    "optional": [
      { "name": "_initialize", "params": [], "results": [] },
      { "name": "xihan_handle_event", "params": ["i32", "i32"], "results": ["i64"], "requiredWhen": "subscriptions" },
      { "name": "xihan_middleware", "params": ["i32", "i32"], "results": ["i64"], "requiredWhen": "contributes.pipeline" }
    ],
    "rejected": [
      { "name": "_start", "reason": "command modules are not accepted" }
    ]
  },
  "imports": {
    "xihan": [
      { "name": "log", "params": ["i32", "i32", "i32"], "results": [] },
      { "name": "invoke", "params": ["i32", "i32"], "results": ["i64"], "permission": "capability:kernel.pipeline" },
      { "name": "publish", "params": ["i32", "i32"], "results": ["i64"], "permission": "capability:messaging.queue" }
    ],
    "wasi_snapshot_preview1": "provided by the host"
  },
  "resultEncoding": "(ptr << 32) | len; 0 means no response"
}
