{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.xihanfun.com/packaging/app.v1.json",
  "title": "XiHan application manifest",
  "description": "xihan.app.json：应用的部署描述，xihan pack 据此生成 Dockerfile、Kustomize、Compose 与 Aspire 产物。",
  "type": "object",
  "required": ["name", "project"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$", "description": "DNS 标签；镜像、k8s 资源与 Compose 项目的默认名" },
    "project": { "type": "string", "minLength": 1, "description": "相对清单所在目录的项目文件" },
    "profile": { "enum": ["minimal", "standard", "full"], "default": "standard" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "context": { "type": "string", "minLength": 1, "default": "." } }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "default": "latest" },
        "aot": { "type": "boolean", "default": false }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http": { "$ref": "#/$defs/port", "default": 8080 },
        "grpc": { "$ref": "#/$defs/port" }
      }
    },
    "bindings": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["connection:relational", "cache:distributed", "queue", "blob"] },
          "secret": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mountPath": { "type": "string", "pattern": "^/", "default": "/etc/xihan" },
        "files": { "type": "array", "items": { "type": "string", "pattern": "^[^/\\\\]+$" }, "uniqueItems": true }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startupSeconds": { "type": "integer", "minimum": 1, "default": 60 },
        "periodSeconds": { "type": "integer", "minimum": 1, "default": 10 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "default": 2 }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "graceSeconds": { "type": "integer", "minimum": 1, "default": 30 } }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "$ref": "#/$defs/quantities" },
        "limits": { "$ref": "#/$defs/quantities" }
      }
    },
    "replicas": { "type": "integer", "minimum": 1, "default": 1 },
    "scaling": {
      "type": "object",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 },
        "cpuPercent": { "type": "integer", "minimum": 1, "maximum": 100, "default": 70 }
      }
    },
    "leader": {
      "type": "object",
      "required": ["lease"],
      "additionalProperties": false,
      "properties": { "lease": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" } }
    },
    "environment": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "quantity": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$" },
    "quantities": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "cpu": { "$ref": "#/$defs/quantity" }, "memory": { "$ref": "#/$defs/quantity" } }
    }
  }
}
