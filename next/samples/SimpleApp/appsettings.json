{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Grpc": {
        "Url": "http://localhost:5001",
        "Protocols": "Http2"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "XiHan": {
    "Kernel": {
      "StartTimeoutSeconds": 30,
      "StopTimeoutSeconds": 30,
      "FailurePolicy": "TerminateStartup"
    },
    "MultiTenancy": {
      "Tenants": {
        "acme": {
          "DisplayName": "Acme Corp"
        },
        "globex": {
          "DisplayName": "Globex",
          "IsEnabled": false
        }
      }
    },
    "Security": {
      "InMemory": {
        "Principals": {
          "alice": {
            "ApiKey": "dev-alice-key",
            "DisplayName": "Alice",
            "Roles": "editor",
            "Tenant": "acme"
          },
          "bob": {
            "ApiKey": "dev-bob-key",
            "DisplayName": "Bob",
            "Roles": "viewer",
            "Tenant": "acme"
          }
        },
        "Grants": {
          "role": {
            "editor": "orders.read,orders.write",
            "viewer": "orders.read"
          }
        }
      }
    },
    "Messaging": {
      "Outbox": {
        "PollIntervalSeconds": 0.5
      }
    }
  }
}
