<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>SimpleApp</RootNamespace>
    <!-- 最小 API 的端点委托在编译期生成，去掉反射绑定，保证 Native AOT 可发布 -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standard 组合：内核、宿主与五个子系统的内存默认实现 -->
    <ProjectReference Include="../../src/XiHan.Framework.Profiles.Standard/XiHan.Framework.Profiles.Standard.csproj" />
    <!-- 操作契约经 HTTP 暴露：orders.create → POST /orders，orders.list → GET /orders -->
    <ProjectReference Include="../../src/XiHan.Framework.Protocols.Http/XiHan.Framework.Protocols.Http.csproj" />
    <!-- 源生成器：从 [Operation] 生成登记代码与 JSON Schema，不进入运行时依赖 -->
    <ProjectReference Include="../../src/XiHan.Framework.Kernel.Generators/XiHan.Framework.Kernel.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 应用自己的消息模板译文，与框架包同一格式：一种语言一个文件 -->
    <EmbeddedResource Include="Localization/*.json" LogicalName="Localization/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
