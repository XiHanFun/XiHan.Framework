<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>SimpleApp</RootNamespace>
    <!-- 最小 API 的端点委托在编译期生成，去掉反射绑定，保证 Native AOT 可发布 -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <!-- 以 Native AOT 发布（CI 冒烟）。写在项目里而不是命令行：命令行的全局属性会传给引用的 netstandard2.0 分析器与生成器，报 NETSDK1207 -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standard 组合：内核、宿主与五个子系统的内存默认实现 -->
    <ProjectReference Include="../../src/XiHan.Framework.Profiles.Standard/XiHan.Framework.Profiles.Standard.csproj" />
    <!-- 操作契约经 HTTP 暴露：orders.create → POST /orders，orders.list → GET /orders -->
    <ProjectReference Include="../../src/XiHan.Framework.Protocols.Http/XiHan.Framework.Protocols.Http.csproj" />
    <!-- 同一份契约经 MCP 暴露：orders_create / orders_list 两个 tool -->
    <ProjectReference Include="../../src/XiHan.Framework.Protocols.Mcp/XiHan.Framework.Protocols.Mcp.csproj" />
    <!-- 同一份契约经 gRPC 暴露：Orders/Create、Orders/List，.proto 从 Schema 生成 -->
    <ProjectReference Include="../../src/XiHan.Framework.Protocols.Grpc/XiHan.Framework.Protocols.Grpc.csproj" />
    <!-- 入站 CloudEvents（POST /events）按类型映射到主题，经管道交给消息处理器 -->
    <ProjectReference Include="../../src/XiHan.Framework.Protocols.CloudEvents/XiHan.Framework.Protocols.CloudEvents.csproj" />
    <!-- 源生成器：从 [Operation] 生成登记代码与 JSON Schema，不进入运行时依赖 -->
    <ProjectReference Include="../../src/XiHan.Framework.Kernel.Generators/XiHan.Framework.Kernel.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/XiHan.Framework.Persistence.Generators/XiHan.Framework.Persistence.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 应用自己的消息模板译文，与框架包同一格式：一种语言一个文件 -->
    <EmbeddedResource Include="Localization/*.json" LogicalName="Localization/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
