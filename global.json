{
  "sdk": {
    "version": "10.0.111",
    // latestFeature 会滚动到 10.0.4xx（实测 10.0.400 下解决方案还原全线失败，NuGet 回归），
    // 因此不放开功能带，只允许同带内补丁升级。
    // 曾锁 10.0.302，但该补丁并非常见分发版本，开发机普遍装不到，
    // latestPatch 又不跨功能带，结果 dotnet 全线报 SDK not found，整仓不可构建；
    // 改锁 10.0.1xx（.NET 10 GA 功能带，分发最广），已实测还原/构建/测试三绿。
    "rollForward": "latestPatch"
  },
  "test": {
    // .NET 10 的 MTP 模式：dotnet test 直接驱动 Microsoft.Testing.Platform 测试应用。
    // 没有它，dotnet test 会走 VSTest 目标并被 MTP 在 .NET 10 SDK 下硬性拒绝。
    "runner": "Microsoft.Testing.Platform"
  }
}
