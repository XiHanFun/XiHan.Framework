{
  "sdk": {
    "version": "10.0.403",
    // 不放开功能带，只允许同带内补丁升级：换功能带曾让解决方案还原全线失败（实测 10.0.400，NuGet 回归），10.0.403 上已不复现。
    // 10.0.403 带运行时 10.0.14，含 GHSA-p3jp-9v83-76w9 的修复；10.0.3xx 功能带停在 10.0.303（运行时 10.0.11），没有这个修复。
    // CI 的 setup-dotnet 按这个版本精确安装。
    // latestPatch 不跨功能带：只装了别的功能带时 dotnet 全线报 SDK not found，装上 10.0.403 即可。
    // 曾锁 10.0.302、10.0.111、10.0.303。
    "rollForward": "latestPatch"
  },
  "test": {
    // .NET 10 的 MTP 模式：dotnet test 直接驱动 Microsoft.Testing.Platform 测试应用。
    // 没有它，dotnet test 会走 VSTest 目标并被 MTP 在 .NET 10 SDK 下硬性拒绝。
    "runner": "Microsoft.Testing.Platform"
  }
}
