<Project>
  <!-- 所有包共享一条版本线；本文件不导入仓库根的任何 props，framework 目录自成一体 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet 审计：高危(NU1903)/严重(NU1904)漏洞直接中断构建 -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- .editorconfig 里的命名与风格规则在构建期一并执行，IDE 与 CI 同一口径 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Version>5.0.0-rc.1</Version>
    <!-- 包验证基线：同一大版本最近一次发布的版本，空表示不比对。5.0.0 上 NuGet 之后在发版提交里填上（ADR-0131） -->
    <XiHanPackageBaselineVersion></XiHanPackageBaselineVersion>
    <Authors>XiHanFun</Authors>
    <Company>XiHanFun</Company>
    <Copyright>Copyright (c) 2021-Present XiHanFun and contributors.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://framework.docs.xihanfun.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/XiHanFun/XiHan.Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- 默认不可打包，src/Directory.Build.props 对正式包打开 -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages/</PackageOutputPath>
  </PropertyGroup>
</Project>
