{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
//#if (Data || MultiTenancy || Observability)
  "AllowedHosts": "*",
  "XiHan": {
//#if (Data)
    "Data": {
      "SqlSugarCore": {
        "ConnectionConfigs": [
          {
            "ConfigId": "Default",
            "DbType": "Sqlite",
            "ConnectionString": "Data Source=webapphost-db.db"
          }
        ],
        "EnableDbInitialization": true,
        "EnableTableInitialization": true
      }
//#if (MultiTenancy || Observability)
    },
//#else
    }
//#endif
//#endif
//#if (MultiTenancy)
    "MultiTenancy": {
      "DefaultStore": {
        "Tenants": [
          {
            "Id": 1,
            "Name": "demo",
            "NormalizedName": "DEMO"
          }
        ]
      }
//#if (Observability)
    },
//#else
    }
//#endif
//#endif
//#if (Observability)
    "Observability": {
      "Enabled": false,
      "ServiceName": "XiHanWebApp"
    }
//#endif
  }
//#else
  "AllowedHosts": "*"
//#endif
}
