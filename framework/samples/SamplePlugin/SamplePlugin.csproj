<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SamplePlugin</RootNamespace>
    <AssemblyName>SamplePlugin</AssemblyName>
    <!-- 插件以目录形式分发：程序集 + xihan.manifest.json + 私有依赖 -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/XiHan.Framework.Kernel/XiHan.Framework.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xihan.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
