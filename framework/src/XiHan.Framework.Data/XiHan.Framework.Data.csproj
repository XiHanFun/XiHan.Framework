<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\..\props\netcore.props" />
	<Import Project="..\..\props\common.props" />
	<Import Project="..\..\props\version.props" />
	<Import Project="..\..\props\nuget.props" />

	<PropertyGroup>
		<Title>XiHan.Framework.Data</Title>
		<AssemblyName>XiHan.Framework.Data</AssemblyName>
		<PackageId>XiHan.Framework.Data</PackageId>
		<Description>曦寒框架数据访问库</Description>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SqlSugarCore" Version="5.1.4.221" />
		<!-- 传递依赖钉住：SqlSugarCore → Microsoft.Data.Sqlite 10.0.9 → SQLitePCLRaw 2.1.11 存在
		     高危漏洞 CVE-2025-6965（GHSA-2m69-gcr7-jv3q，2.1.12 起修复）。
		     最近获胜原则把整条链抬到 2.1.13，上游升级后可移除本行。 -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
		<!-- 传递依赖钉住：SqlSugarCore → Oracle.ManagedDataAccess.Core 23.8.0 → System.Security.Cryptography.Pkcs 8.0.1 存在
		     高危漏洞 CVE-2026-84008（GHSA-846f-f764-76mx）与中危漏洞 CVE-2026-70162（GHSA-2fmv-rv2c-59x7），10.0.13 起修复。
		     最近获胜原则把它抬到 10.0.13，上游升级后可移除本行。 -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\XiHan.Framework.Auditing\XiHan.Framework.Auditing.csproj" />
	  <ProjectReference Include="..\XiHan.Framework.Core\XiHan.Framework.Core.csproj" />
	  <ProjectReference Include="..\XiHan.Framework.DistributedIds\XiHan.Framework.DistributedIds.csproj" />
	  <ProjectReference Include="..\XiHan.Framework.Domain\XiHan.Framework.Domain.csproj" />
	  <ProjectReference Include="..\XiHan.Framework.MultiTenancy\XiHan.Framework.MultiTenancy.csproj" />
	  <ProjectReference Include="..\XiHan.Framework.Security\XiHan.Framework.Security.csproj" />
	  <ProjectReference Include="..\XiHan.Framework.Uow\XiHan.Framework.Uow.csproj" />
	</ItemGroup>

</Project>
