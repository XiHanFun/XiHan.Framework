<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>XiHan.Framework.Cli</PackageId>
    <RootNamespace>XiHan.Framework.Cli</RootNamespace>
    <Description>XiHan Framework 命令行工具 xihan：xihan pack 从 xihan.app.json 生成 Dockerfile、Kustomize、Compose 与 Aspire 产物；graph / pipeline / operations / invoke 转发给应用的命令行宿主；xihan mcp 以 stdio 提供框架离线知识库（包与特性清单、配置键与缺省值、文档）的 MCP 服务。</Description>
    <PackageTags>xihan;framework;cli;tool;pack;docker;kubernetes;aspire;mcp</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xihan</ToolCommandName>
    <!-- 工具包没有库程序集，包验证不适用 -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XiHan.Framework.Hosting.CommandLine/XiHan.Framework.Hosting.CommandLine.csproj" />
    <ProjectReference Include="../XiHan.Framework.Localization.InMemory/XiHan.Framework.Localization.InMemory.csproj" />
    <!-- xihan mcp 内嵌一个最小的 XiHan 应用，由 MCP 协议适配器处理 JSON-RPC 与 stdio 传输 -->
    <ProjectReference Include="../XiHan.Framework.Protocols.Mcp/XiHan.Framework.Protocols.Mcp.csproj" />
    <!-- migrate v4 做语法级重写：只用语法树，不加载 MSBuild 工作区 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XiHan.Framework.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 消息模板的译文：一种语言一个文件（RFC-0010） -->
    <EmbeddedResource Include="Localization/*.json" LogicalName="Localization/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- 离线知识库（ADR-0076）：包与特性清单、配置节索引，以及构建时的文档站、规范与各包 README，随工具一起发布 -->
  <ItemGroup>
    <EmbeddedResource Include="Knowledge/catalog.json" LogicalName="knowledge/catalog.json" />
    <EmbeddedResource Include="Knowledge/configuration.json" LogicalName="knowledge/configuration.json" />
    <EmbeddedResource Include="skills/xihan-framework/SKILL.md" LogicalName="skills/xihan-framework/SKILL.md" WithCulture="false" />
    <EmbeddedResource Include="../../../docs-next/**/*.md" Exclude="../../../docs-next/node_modules/**;../../../docs-next/.vitepress/**;../../../docs-next/public/**" LogicalName="docs/docs-next/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" Visible="false" />
    <EmbeddedResource Include="../../spec/rfcs/*.md" LogicalName="docs/next/spec/rfcs/%(Filename)%(Extension)" WithCulture="false" Visible="false" />
    <EmbeddedResource Include="../../spec/conventions/*.md" LogicalName="docs/next/spec/conventions/%(Filename)%(Extension)" WithCulture="false" Visible="false" />
    <EmbeddedResource Include="../*/README.md" LogicalName="docs/next/src/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" Visible="false" />
  </ItemGroup>
</Project>
