<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>XiHan.Framework.Caching.Redis</PackageId>
    <RootNamespace>XiHan.Framework.Caching.Redis</RootNamespace>
    <Description>曦寒框架缓存的 Redis 提供程序</Description>
    <PackageTags>xihan;framework;caching;redis;distributed-lock</PackageTags>
    <!-- StackExchange.Redis 未声明 AOT 兼容；Native AOT 场景另行验证 -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XiHan.Framework.Caching.Abstractions/XiHan.Framework.Caching.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
</Project>
