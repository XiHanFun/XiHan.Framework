<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>XiHan.Framework.Auditing.Abstractions</PackageId>
    <RootNamespace>XiHan.Framework.Auditing.Abstractions</RootNamespace>
    <Description>XiHan Framework 审计契约（Ring 2）：Observe 阶段的审计中间件、调用上下文的动作 / 资源 / 细节扩展、查询契约 IAuditTrail 与选项。</Description>
    <PackageTags>xihan;framework;auditing;audit-trail</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XiHan.Framework.Kernel/XiHan.Framework.Kernel.csproj" />
    <ProjectReference Include="../XiHan.Framework.Localization.Abstractions/XiHan.Framework.Localization.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 消息模板的译文：一种语言一个文件（RFC-0010），由本地化目录按 Localization/<区域>.json 读取 -->
    <EmbeddedResource Include="Localization/*.json" LogicalName="Localization/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
