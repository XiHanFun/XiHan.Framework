<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\props\netcore.props" />
    <Import Project="..\..\props\common.props" />
    <Import Project="..\..\props\version.props" />
    <Import Project="..\..\props\nuget.props" />

    <PropertyGroup>
        <Title>XiHan.Framework.Bot.Email</Title>
        <AssemblyName>XiHan.Framework.Bot.Email</AssemblyName>
        <PackageId>XiHan.Framework.Bot.Email</PackageId>
        <Description>曦寒框架机器人邮件库</Description>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MailKit" Version="4.18.1" />
        <!-- 传递依赖钉住：MailKit → MimeKit 4.18.1 → System.Security.Cryptography.Pkcs 10.0.0 存在
             高危漏洞 CVE-2026-84008（GHSA-846f-f764-76mx）与中危漏洞 CVE-2026-70162（GHSA-2fmv-rv2c-59x7），10.0.13 起修复。
             最近获胜原则把它抬到 10.0.13，上游升级后可移除本行。 -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\XiHan.Framework.Bot\XiHan.Framework.Bot.csproj" />
    </ItemGroup>

</Project>
