<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>XiHan.Framework.Plugins.Wasm</PackageId>
    <RootNamespace>XiHan.Framework.Plugins.Wasm</RootNamespace>
    <Description>曦寒框架 Wasm 插件宿主</Description>
    <PackageTags>xihan;framework;plugins;wasm;wasmtime;wasi</PackageTags>
    <!-- wasmtime 原生绑定与 Google.Protobuf 都未声明 AOT 兼容 -->
    <IsAotCompatible>false</IsAotCompatible>
    <!-- ShadowStackGuard 的 LibraryImport 生成代码需要 unsafe；源码本身不写 unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 一致性套件与测试复用模块校验与实例 -->
    <InternalsVisibleTo Include="XiHan.Framework.Plugins.Conformance" />
    <InternalsVisibleTo Include="XiHan.Framework.Plugins.Wasm.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../XiHan.Framework.Kernel/XiHan.Framework.Kernel.csproj" />
    <ProjectReference Include="../XiHan.Framework.Plugins.Protocol/XiHan.Framework.Plugins.Protocol.csproj" />
    <ProjectReference Include="../XiHan.Framework.Messaging.Abstractions/XiHan.Framework.Messaging.Abstractions.csproj" />
    <ProjectReference Include="../XiHan.Framework.Localization.Abstractions/XiHan.Framework.Localization.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wasmtime" />
  </ItemGroup>
</Project>
