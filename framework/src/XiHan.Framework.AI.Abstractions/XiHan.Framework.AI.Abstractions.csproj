<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>XiHan.Framework.AI.Abstractions</PackageId>
    <RootNamespace>XiHan.Framework.AI.Abstractions</RootNamespace>
    <Description>XiHan Framework AI 契约：基于 Microsoft.Extensions.AI 的 Provider 目录、带提示词 / 护栏 / 工具的聊天入口、操作契约桥接成模型工具的目录、知识库流水线与存储契约。</Description>
    <PackageTags>xihan;framework;ai;chat;embedding;tools;rag;knowledge</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XiHan.Framework.Kernel/XiHan.Framework.Kernel.csproj" />
    <ProjectReference Include="../XiHan.Framework.Localization.Abstractions/XiHan.Framework.Localization.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization/*.json" LogicalName="Localization/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
