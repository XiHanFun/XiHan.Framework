<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>XiHan.Framework.AI.Conformance</PackageId>
    <RootNamespace>XiHan.Framework.AI.Conformance</RootNamespace>
    <Description>XiHan Framework AI 一致性套件：知识库存储与模型 Provider 目录必须通过的 xUnit 抽象测试类，含确定性的哈希嵌入生成器。</Description>
    <PackageTags>xihan;framework;ai;conformance;xunit</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- CA1707：用例名沿用测试项目的下划线分段约定 -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XiHan.Framework.AI.Abstractions/XiHan.Framework.AI.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>
</Project>
