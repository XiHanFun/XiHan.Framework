# =============================================================================
# XiHan.Framework.Docs.Mcp.Web —— Caddy 反向代理样例
#
# 这是起点，不是审计过的配置。原样贴上去就当自己安全了，比没有样例更糟：
# 它把「还没想过的问题」换成了「以为已经想过的问题」。
# 部署前必须自己决定的四件事，见 README 的「摆到反向代理后面」一节。
#
# 占位符（全部要替换）：
#   mcp.example.com   -> 你的域名
#   127.0.0.1:5199    -> 文档 MCP 进程实际监听的地址
#   admin@example.com -> 接收证书到期通知的邮箱
#   203.0.113.0/24    -> 允许访问的网段
#
# 校验：caddy validate --config ./Caddyfile      重载：caddy reload --config ./Caddyfile
# =============================================================================

{
	# ACME 账户邮箱，证书出问题时 CA 会发通知。可省略，但不建议
	email admin@example.com

	servers {
		# 连接级限制。上游只处理短小的 POST，没有长连流（见下方 reverse_proxy 处的实测说明），
		# 因此这些超时可以压得很紧：慢速读写（Slowloris 一类）在这里就被掐断，到不了上游
		timeouts {
			read_header 5s
			read_body 10s
			write 30s
			idle 30s
		}
		# 请求头总量上限。默认值已够用，写出来是为了让「它有上限」这件事显式化
		max_header_size 16KB
	}

	# rate_limit 不在 Caddy 标准发行版里，需要自行构建：
	#   xcaddy build --with github.com/mholt/caddy-ratelimit
	# 没有这个模块时，Caddy 会因为「无法识别的指令 rate_limit」直接启动失败，
	# 不会静默跳过 —— 失败得早是好事，但也意味着这份配置不能原样贴进标准版 Caddy。
	# 不想自行构建：删掉下面那整个 rate_limit 块，改由防火墙或云厂商的 WAF 限流。
	#
	# 该模块自带排序（排在 basic_auth 之前），一般不用管；要改才写这行：
	# order rate_limit after basic_auth
}

mcp.example.com {
	# ---------------------------------------------------------------------
	# HTTPS
	# ---------------------------------------------------------------------
	# 这里没有任何 tls 指令，是因为 Caddy 对公网域名默认自动申请并续期证书，
	# 同时自动把 80 端口重定向到 443 —— 两件事都不用配。前提是：
	#   1) 域名的 A/AAAA 记录已指向本机；2) 80 与 443 都能从公网到达本机。
	# 内网或自签场景改用：tls internal
	#
	# 上游自己不做 TLS。「代理到上游」这一跳必须留在本机（127.0.0.1）或可信内网，
	# 跨公网转发就等于把密钥明文发出去，前面这段 HTTPS 也就白配了。

	# ---------------------------------------------------------------------
	# 谁能碰到这个端点（默认注释掉：这是你要自己决定的事，样例替不了你决定）
	# ---------------------------------------------------------------------
	# 只对已知网段开放，比限流有效得多：密钥泄露之后，网段限制仍然拦得住。
	# @blocked not remote_ip 203.0.113.0/24 198.51.100.7
	# respond @blocked 403

	# ---------------------------------------------------------------------
	# 访问日志：密钥绝不能落盘
	# ---------------------------------------------------------------------
	log {
		output file /var/log/caddy/xihan-docs-mcp.access.log {
			roll_size 10MiB
			roll_keep 5
			# 轮转后的文件保留多久。默认 2160h（90 天），这里收到 30 天。
			# 留存期限是合规问题，按你自己的策略定，别照抄
			roll_keep_for 720h
		}
		format filter {
			# 这一段是本文件里最容易漏、漏了代价最大的部分。
			# Caddy 的访问日志默认会把整个请求头集合写进去，其中只有
			# Cookie / Set-Cookie / Authorization / Proxy-Authorization 会被自动写成 REDACTED。
			# X-Api-Key 不在这个名单里 —— 少了下面这行，密钥就明文写进磁盘，
			# 并跟着日志进备份、进日志采集系统，删掉原文件也追不回来。
			request>headers>X-Api-Key delete
			# Authorization 默认虽已 REDACTED，仍显式删掉：
			# 改了 HeaderName、换了 Caddy 版本或有人动了默认名单时，这一行是兜底
			request>headers>Authorization delete
			# 客户端 IP 属于个人数据。要打码就放开这段（保留网段、抹掉主机位）：
			# request>remote_ip ip_mask {
			# 	ipv4 24
			# 	ipv6 32
			# }
		}
	}

	# ---------------------------------------------------------------------
	# 只转发 /mcp，其余一律 404
	# ---------------------------------------------------------------------
	# 实测上游只有这一个端点：/ 、/health、/mcp/sse、/mcp/message 全部 404。
	# 带尾斜杠的 /mcp/ 同样返回 200，所以这里两个都要写。
	# path 匹配是精确的，不会顺带把 /mcpx 收进来
	@mcp path /mcp /mcp/
	handle @mcp {
		# 请求体上限。实测：initialize 152 字节，tools/call 115~550 字节。
		# 64KB 已是几十倍余量，却挡掉了「甩一个超大 body 过来拖垮上游」这种最省事的 DoS。
		# 超限返回 413
		request_body {
			max_size 64KB
		}

		# 单 IP 限流：60 秒内 60 次，超出返回 429 并带 Retry-After。
		# 说清楚它挡什么、不挡什么：
		#   挡得住 —— 单一来源的高频请求（脚本跑飞、爬虫、一台机器暴力试 key）。
		#   挡不住 —— 分布式来源；更挡不住密钥泄露后从很多地址发来的请求，
		#             那些请求每个来源都在限额内，会一路畅通地走进上游。
		# 限流是防滥用的减速带，不是访问控制。访问控制是上面的 remote_ip 白名单与密钥本身。
		# 60 次 / 60 秒只是个保守起点，不是建议值：一个 AI 客户端连着检索几十次很常见，
		# 定太紧会把正常用法打成 429。按你自己的调用量调，调完实测一遍。
		# 需要 xcaddy 构建（见文件开头）；不构建就整块删掉
		rate_limit {
			zone xihan_docs_mcp {
				key {remote_host}
				events 60
				window 60s
			}
		}

		reverse_proxy 127.0.0.1:5199 {
			# 关于这个传输，实测结论（不要照搬网上的 websocket 代理模板）：
			#   * 只有 POST。GET /mcp 与 DELETE /mcp 都返回 405 Allow: POST，
			#     没有长连的 SSE 通道，因此不需要任何 Upgrade / Connection: upgrade 配置。
			#   * 响应 Content-Type 是 text/event-stream，Caddy 对这个类型自动立即冲刷，
			#     不必写 flush_interval。
			#   * 服务端默认 Stateless=true，响应里没有 Mcp-Session-Id，
			#     多实例时不需要会话粘滞，可以随便轮询。
			#   * 客户端请求头默认原样透传（Caddy 只额外加 X-Forwarded-For/Proto/Host）。
			#     千万别改写 Accept：少了 text/event-stream 上游直接回 406，
			#     那是内容协商失败不是鉴权失败，很容易误判成密钥不对。
			transport http {
				read_timeout 60s
			}
		}
	}

	# 其余路径连转发都不转发，直接 404
	handle {
		respond 404
	}
}
